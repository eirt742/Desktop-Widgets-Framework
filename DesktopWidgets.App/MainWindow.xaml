
<Window x:Class="DesktopWidgets.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Widgets"
        Width="1050"
        Height="720"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="#F5F5F7"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>

        <!-- Цвета iOS 18 -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#242428"/>
        <SolidColorBrush x:Key="CardBrush" Color="#2C2C30"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#36363B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#98989F"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#30D158"/>
        <SolidColorBrush x:Key="RedBrush" Color="#FF453A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3E"/>

        <!-- Кнопка в стиле iOS -->
        <Style x:Key="IosButton" TargetType="Button">
            <Setter Property="Background" Value="#2C2C30"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="False">

                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3A3A40"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.7"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Синяя кнопка -->
        <Style x:Key="AccentButton"
               TargetType="Button"
               BasedOn="{StaticResource IosButton}">
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Карточка виджета -->
        <Style x:Key="WidgetCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Padding" Value="17"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#353539"/>
        </Style>

        <!-- iOS 18 ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent"
                              Width="6">

                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        Command="{x:Static ScrollBar.PageUpCommand}"
                                        Opacity="0"
                                        IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="#66666E"
                                                        CornerRadius="3"
                                                        Margin="0,1"/>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#98989F"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                        Command="{x:Static ScrollBar.PageDownCommand}"
                                        Opacity="0"
                                        IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>

                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Источник данных с фильтрацией -->
        <CollectionViewSource
            x:Key="WidgetsView"
            Source="{Binding Widgets}"
            Filter="WidgetsView_Filter"/>

    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}"
            CornerRadius="20"
            BorderBrush="#3A3A3E"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0"
                    Background="#222226"
                    CornerRadius="20,20,0,0"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">

                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Width="30"
                                Height="30"
                                CornerRadius="9"
                                Background="#0A84FF"
                                Margin="0,0,11,0">

                            <TextBlock Text="◈"
                                       FontSize="19"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Desktop Widgets"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="  •  "
                                   Foreground="#636369"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Library"
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Кнопки управления окном -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Свернуть -->
                        <Button Width="34"
                                Height="30"
                                Padding="0"
                                Margin="0,0,8,0"
                                Style="{StaticResource IosButton}"
                                Click="MinimizeWindow_Click"
                                ToolTip="Свернуть">

                            <TextBlock Text="−"
                                       FontFamily="Segoe UI"
                                       FontSize="27"
                                       FontWeight="Light"
                                       Foreground="#F5F5F7"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <!-- Скрыть в трей -->
                        <Button Width="34"
                                Height="30"
                                Padding="0"
                                Background="#3A2526"
                                Style="{StaticResource IosButton}"
                                Click="CloseToTray_CLick"
                                ToolTip="Скрыть в трей">

                            <TextBlock Text="×"
                                       FontFamily="Segoe UI"
                                       FontSize="23"
                                       FontWeight="Light"
                                       Foreground="#FF6961"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Заголовок и статистика -->
            <Grid Grid.Row="1"
                  Margin="30,28,30,22">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Мои виджеты"
                               FontSize="29"
                               FontWeight="Bold"
                               Foreground="#F5F5F7"/>

                    <TextBlock Text="Управляйте виджетами рабочего стола"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#2C2C30"
                        CornerRadius="13"
                        Padding="15,10"
                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource GreenBrush}"
                                 Margin="0,0,9,0"
                                 VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding Widgets.Count}"
                                   FontSize="14"
                                   FontWeight="Bold"/>

                        <TextBlock Text=" виджетов"
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Основная область -->
            <Grid Grid.Row="2"
                  Margin="30,0,16,15">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Панель инструментов -->
                <Grid Grid.Row="0"
                      Margin="0,0,14,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Поиск -->
                    <Border Background="#2C2C30"
                            CornerRadius="12"
                            Height="42"
                            Width="300"
                            HorizontalAlignment="Left">

                        <Grid Margin="13,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="⌕"
                                       FontSize="22"
                                       Foreground="#98989F"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,2"/>

                            <Grid Grid.Column="1">

                                <TextBox x:Name="WidgetSearchBox"
                                         Background="Transparent"
                                         Foreground="#F5F5F7"
                                         CaretBrush="#0A84FF"
                                         BorderThickness="0"
                                         FontSize="13"
                                         VerticalContentAlignment="Center"
                                         TextChanged="WidgetSearchBox_TextChanged"/>

                                <!-- Placeholder -->
                                <TextBlock Text="Поиск виджетов..."
                                           Foreground="#98989F"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding Text, ElementName=WidgetSearchBox}"
                                                    Value="">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Добавить виджет -->
                    <Button Grid.Column="1"
                            Content="+  Добавить виджет"
                            Style="{StaticResource AccentButton}"
                            VerticalAlignment="Center"
                            Click="RefreshWidgets_Clicked"/>
                </Grid>

                <!-- Плитки виджетов -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">

                    <ItemsControl ItemsSource="{Binding Source={StaticResource WidgetsView}}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Style="{StaticResource WidgetCard}"
                                        Width="220"
                                        MinHeight="190">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Иконка и статус -->
                                        <Grid>
                                            <Border Width="43"
                                                    Height="43"
                                                    CornerRadius="13"
                                                    Background="#393940"
                                                    HorizontalAlignment="Left"
                                                    ClipToBounds="True">

                                                <Grid>

                                                    <TextBlock Text="◈"
                                                               FontSize="23"
                                                               Foreground="#64B5FF"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">

                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>

                                                    </TextBlock>

                                                    <Image Source="{Binding Icon}"
                                                           Width="43"
                                                           Height="43"
                                                           Stretch="UniformToFill"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           SnapsToDevicePixels="True"
                                                           RenderOptions.BitmapScalingMode="HighQuality">

                                                        <Image.Clip>
                                                            <RectangleGeometry Rect="0,0,43,43"
                                                                               RadiusX="13"
                                                                               RadiusY="13"/>
                                                        </Image.Clip>

                                                    </Image>

                                                </Grid>
                                            </Border>


                                            <!-- Статус -->
                                            <Border CornerRadius="8"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top">

                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="#3A2929"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Background"
                                                                        Value="#203B2B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel Orientation="Horizontal">

                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             VerticalAlignment="Center">

                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill"
                                                                        Value="#FF453A"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                        <Setter Property="Fill"
                                                                                Value="#30D158"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>

                                                    <TextBlock FontSize="10"
                                                               Margin="5,0,0,0">

                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text"
                                                                        Value="Остановлен"/>
                                                                <Setter Property="Foreground"
                                                                        Value="#FF6961"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                        <Setter Property="Text"
                                                                                Value="Запущен"/>
                                                                        <Setter Property="Foreground"
                                                                                Value="#30D158"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Название и описание -->
                                        <StackPanel Grid.Row="1"
                                                    VerticalAlignment="Center">

                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F5F5F7"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="34"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <!-- Кнопка запуска -->
                                        <Button Grid.Row="2"
                                                Height="36"
                                                MinWidth="120"
                                                Padding="12,6"
                                                HorizontalAlignment="Stretch"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                Click="WidgetButton_Click">

                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource AccentButton}">

                                                    <Setter Property="Content"
                                                            Value="Запустить"/>

                                                    <Setter Property="Background"
                                                            Value="#0A84FF"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Content"
                                                                    Value="Остановить"/>

                                                            <Setter Property="Background"
                                                                    Value="#3A2929"/>

                                                            <Setter Property="Foreground"
                                                                    Value="#FF6961"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>

                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Нижняя панель -->
            <Border Grid.Row="3"
                    Background="#222226"
                    CornerRadius="0,0,20,20"
                    Padding="25,13">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Настройки -->
                    <Button Grid.Column="0"
                            Width="40"
                            Height="40"
                            Margin="10"
                            Padding="0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource IosButton}"
                            ToolTip="Настройки">

                        <Image Source="pack://application:,,,/Resources/Icons/settings_icon.png"
                               Width="22"
                               Height="22"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Button>
                    
                    <Button Grid.Column="1"
                            Width="40"
                            Height="40"
                            Margin="10"
                            Padding="0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource IosButton}"
                            ToolTip="Перезагрузить установленые виджеты"
                            Click="RefreshWidgets_Clicked">

                        <Image Source="pack://application:,,,/Resources/Icons/reload.png"
                               Width="22"
                               Height="22"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Button>

                    <!-- Название приложения -->
                    <TextBlock Grid.Column="2"
                               Text="Desktop Widgets"
                               FontSize="11"
                               Foreground="#636369"
                               VerticalAlignment="Center"
                               Margin="10,0"/>

                    <!-- Режим редактирования -->
                    <TextBlock Grid.Column="3"
                               Text="Ctrl + F9  •  Edit Mode"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="10,0"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
