<Window x:Class="DesktopWidgets.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Widgets"
        Width="650"
        Height="500"
        MinWidth="550"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#202020"
        Foreground="White">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Desktop Widgets"
                       FontSize="26"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Управление виджетами рабочего стола"
                       Foreground="#AAAAAA"
                       FontSize="13"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Поиск и добавление -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Height="34"
                     Margin="0,0,10,0"
                     Padding="8,5"
                     VerticalContentAlignment="Center"
                     Background="#303030"
                     Foreground="White"
                     BorderBrush="#505050"
                     Text="Поиск виджетов..."/>

            <Button Grid.Column="1"
                    Content="+ Добавить"
                    Width="110"
                    Height="34"
                    Background="#454545"
                    Foreground="White"
                    BorderBrush="#606060"/>
        </Grid>

        <!-- Список виджетов -->
        <Border Grid.Row="2"
                Background="#292929"
                BorderBrush="#404040"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding Widgets}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Background="#333333"
                                    CornerRadius="4"
                                    Padding="12"
                                    Margin="0,0,0,8">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Название и описание -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="#AAAAAA"
                                                   FontSize="12"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Width="85"
                                            Height="30"
                                            Tag="{Binding Name}"
                                            Click="WidgetButton_Click"
                                            Background="#454545"
                                            Foreground="White"
                                            BorderBrush="#606060">

                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <!-- Обычное состояние -->
                                                <Setter Property="Content" Value="Запустить"/>
                                                <Setter Property="Background" Value="#454545"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#606060"/>

                                                <Style.Triggers>
                                                    <!-- Виджет запущен -->
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Content" Value="Закрыть"/>
                                                        <Setter Property="Background" Value="#A83232"/>
                                                        <Setter Property="BorderBrush" Value="#D94A4A"/>
                                                    </DataTrigger>

                                                    <!-- Виджет остановлен -->
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                        <Setter Property="Background" Value="#287A45"/>
                                                        <Setter Property="BorderBrush" Value="#38A85D"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>
        </Border>

        <!-- Нижняя панель -->
        <Grid Grid.Row="3" Margin="0,15,0,0">

            <TextBlock Foreground="#AAAAAA"
                       VerticalAlignment="Center"
                       Text="{Binding Widgets.Count,
                              StringFormat=Установлено виджетов: {0}}"/>

            <Button Content="Свернуть в трей"
                    Width="130"
                    Height="32"
                    HorizontalAlignment="Right"
                    Background="#454545"
                    Foreground="White"
                    BorderBrush="#606060"
                    Click="CloseToTray_CLick"/>

        </Grid>

    </Grid>
</Window>
