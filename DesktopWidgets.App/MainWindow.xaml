
<Window x:Class="DesktopWidgets.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Widgets"
        Width="650"
        Height="500"
        MinWidth="550"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#151518"
        Foreground="#F5F5F7"
        FontFamily="Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>

        <!-- Palette -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#151518"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#202024"/>
        <SolidColorBrush x:Key="CardBrush" Color="#29292F"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#33333B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3A3A42"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0A84FF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9898A1"/>

        <!-- Search -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#25252B"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="SearchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SearchBorder"
                                        Property="BorderBrush"
                                        Value="#0A84FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SearchBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- General buttons -->
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#303038"/>
            <Setter Property="BorderBrush" Value="#45454E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Widget action button -->
        <Style x:Key="WidgetButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="BorderBrush" Value="#0A84FF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Content" Value="Закрыть"/>
                    <Setter Property="Background" Value="#FF453A"/>
                    <Setter Property="BorderBrush" Value="#FF453A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                    <Setter Property="Content" Value="Запустить"/>
                    <Setter Property="Background" Value="#30A46C"/>
                    <Setter Property="BorderBrush" Value="#30A46C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Widget card -->
        <Style x:Key="WidgetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#35353D"/>
        </Style>

        <!-- Footer button -->
        <Style x:Key="FooterButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#29292F"/>
            <Setter Property="BorderBrush" Value="#414149"/>
            <Setter Property="Foreground" Value="#D6D6DC"/>
        </Style>

    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Desktop Widgets"
                       FontSize="27"
                       FontWeight="SemiBold"
                       Foreground="#F5F5F7"/>

            <TextBlock Text="Управление виджетами рабочего стола"
                       Foreground="#92929C"
                       FontSize="13"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Search and add -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Height="40"
                     Margin="0,0,10,0"
                     Style="{StaticResource SearchBoxStyle}"
                     Text="Поиск виджетов..."/>

            <Button Grid.Column="1"
                    Content="+ Добавить"
                    Width="112"
                    Height="40"
                    Style="{StaticResource BaseButtonStyle}"
                    Background="#0A84FF"
                    BorderBrush="#0A84FF"/>
        </Grid>

        <!-- Widget list -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#35353D"
                BorderThickness="1"
                CornerRadius="15"
                Padding="12">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl ItemsSource="{Binding Widgets}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Style="{StaticResource WidgetCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Name and description -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F5F5F7"/>

                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="#9999A3"
                                                   FontSize="12"
                                                   Margin="0,5,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource WidgetButtonStyle}"
                                            Click="WidgetButton_Click"/>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">

            <TextBlock Foreground="#92929C"
                       VerticalAlignment="Center"
                       Text="{Binding Widgets.Count,
                              StringFormat=Установлено виджетов: {0}}"/>

            <Button Content="Свернуть в трей"
                    Style="{StaticResource FooterButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="CloseToTray_CLick"/>

        </Grid>

    </Grid>
</Window>
